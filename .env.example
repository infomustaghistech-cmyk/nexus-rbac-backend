NODE_ENV=development
PORT=3000
# Number of proxy hops to trust (set to 1 behind a load balancer / Nginx)
TRUST_PROXY=0

MONGO_URI=mongodb://localhost:27017/nexus?replicaSet=rs0
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=nexus-rbac-api
JWT_AUDIENCE=nexus-clients
REFRESH_TOKEN_TTL_DAYS=7

# 32+ characters / 256-bit key for AES-256-GCM MFA secret encryption
MFA_ENCRYPTION_KEY=change-me-to-a-long-mfa-encryption-key-of-at-least-32-chars

# Account Lockout Policy
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_SECONDS=15
LOGIN_ATTEMPT_RESET_MINUTES=60

# Audit retention in days
AUDIT_RETENTION_DAYS=365

# Check passwords against Have I Been Pwned API (k-anonymity)
PASSWORD_BREACH_CHECK=true

BCRYPT_SALT_ROUNDS=12

# Comma-separated list, or * for any origin
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

ROLE_CACHE_TTL_MS=60000
LOG_LEVEL=info
